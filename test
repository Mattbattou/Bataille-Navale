}

void bouton(const char* texte, colors couleurTexte, colors couleurBouton, colors couleurBordure, const int px, int py) {
    py = HAUT - py;  // Correction de la position du bouton (affichage inversé)

    int largeur = 150;
    int hauteur = 50;

    // Dessiner la bordure du rectangle
    setcolor(couleurBordure);  // Couleur de la bordure
    rectangle(px, py, px + largeur, py + hauteur);  // Dessiner la bordure

    // Remplir le rectangle avec la couleur de fond
    setfillstyle(SOLID_FILL, couleurBouton);  // Couleur de fond du bouton
    floodfill(px + 1, py + 1, couleurBordure);  // Remplir à l'intérieur de la bordure

    // Définir la couleur du texte
    setbkcolor(couleurBouton);  // Fond du texte doit être la couleur de fond du bouton
    setcolor(couleurTexte);     // Couleur du texte

    settextstyle(DEFAULT_FONT, HORIZ_DIR, 1);  // Police du texte

    // Calcul de la position du texte pour le centrer
    int textWidth = textwidth(texte);
    int textHeight = textheight(texte);

    int textX = px + (largeur - textWidth) / 2;
    int textY = py + (hauteur - textHeight) / 2;

    // Affichage du texte
    outtextxy(textX, textY, texte);
}





void tips(const char* texte, colors couleurTexte, colors couleurFond, const int px, int py) {
    py = HAUT - py;

    int largeur = 250;
    int hauteur = 100;

    setcolor(couleurFond);
    bar(px, py, px + largeur, py + hauteur);

    setbkcolor(couleurFond);
    setcolor(couleurTexte);
    settextstyle(DEFAULT_FONT, HORIZ_DIR, 1);

    int textWidth = textwidth(texte);
    int textHeight = textheight(texte);

    int textX = px + (largeur - textWidth) / 2;
    int textY = py + (hauteur - textHeight) / 2;

    outtextxy(textX, textY, texte);
}







