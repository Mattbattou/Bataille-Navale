void grille1 (int &n) {
    int var; // pour définir une taille différente pour les grilles.
    if (n == 10)
        var = 40;
    else
        var = 30;


    int px = var, py = var;
    for(int j=1 ; j<= n ; j++) {
        for(int i = 1 ; i <= n ; i++) {
            setcolor(WHITE);
            bar(px,py,px+var,py+var);
            px += var;
        }
        px = var;
        py += var;
    }


    px = var; py = var;
    for(int i = 1 ; i <= n ; i++) {
        setcolor(BLUE);
        line(px+var,py,px+var,py+(var*n));
        px += var;
    }

    px = var; py = var;
    for(int i = 1 ; i <= n ; i++) {
        setcolor(BLUE);
        line(px,py+var,px+(var*n),py+var);
        py += var;
    }
}


void grille2 (int &n) {
